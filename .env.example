# Blaster (blaster/blast.ts). Use a small throwaway wallet; never commit a real key.
BLASTER_WIF=
# Optional
BLASTER_ARC_URL=https://arc.gorillapool.io
BLASTER_FEE_RATE=100

# GorillaPool JungleBus subscription for the live highway (Output types: pubkeyhash)
NEXT_PUBLIC_JUNGLEBUS_SUBSCRIPTION_ID=

# Leaderboard (server only): Hetzner Supabase public API + anon key
SUPABASE_URL=https://api.b0ase.com
SUPABASE_ANON_KEY=

# Multiplayer (Supabase Realtime)
NEXT_PUBLIC_REALTIME_URL=wss://your-supabase/realtime/v1/websocket
NEXT_PUBLIC_REALTIME_KEY=your-anon-key-here

# Chain Frogger paid play: address that receives 1 sat per hop / shot (public address, not a key)
NEXT_PUBLIC_TB_HOUSE_ADDRESS=your-house-address-here

# BlastPad launchpad (/launch). Server only. The pool key holds every coin's curve: generate a fresh
# key, keep it ONLY in the deployment env and a secure backup, never in git.
LAUNCH_POOL_WIF=
# Shared with the database: insert into tokenblaster_secrets values ('launch', '<same value>');
LAUNCH_SECRET=
# worker/vault.ts sends this to POST /api/launch/vault
LAUNCH_CRON_SECRET=
