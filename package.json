{
  "name": "tokenblaster.lol",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm content:index && pnpm storm:build && next dev",
    "build": "pnpm content:check && pnpm storm:build && next build",
    "storm:build": "esbuild src/workers/storm.ts --bundle --format=esm --target=es2022 --minify --outfile=public/storm-worker.js",
    "start": "next start",
    "lint": "eslint",
    "test": "pnpm content:check && tsx --test src/lib/*.test.ts",
    "content:index": "tsx scripts/content-index.ts",
    "content:check": "tsx scripts/content-check.ts",
    "content:score-rows": "tsx scripts/bracer-score-rows.ts",
    "blast": "tsx blaster/blast.ts",
    "worker:build": "esbuild worker/indexer.ts --bundle --platform=node --format=esm --target=node18 --outfile=worker/dist/indexer.mjs --external:pg-native --external:bufferutil --external:utf-8-validate --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "vault:build": "esbuild worker/vault.ts --bundle --platform=node --format=esm --target=node18 --outfile=worker/dist/vault.mjs"
  },
  "dependencies": {
    "@1sat/templates": "0.0.43",
    "@bsv/sdk": "^2.8.11",
    "centrifuge": "^5.7.4",
    "lightweight-charts": "^5.2.1",
    "next": "16.3.8",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "opentype.js": "^2.0.0",
    "pg": "^8.23.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "ws": "^8.22.0"
  },
  "packageManager": "pnpm@10.28.0"
}
