diff -ruN open-games/bubbo-bubbo/src/tb.ts build/bubbo/src/tb.ts
--- open-games/bubbo-bubbo/src/tb.ts	1970-01-01 01:00:00
+++ build/bubbo/src/tb.ts	2026-10-07 09:15:22
@@ -0,0 +1,26 @@
+/**
+ * TokenBlaster.lol bridge. When the game runs inside the arcade page (iframe, ?tb=1) the page owns the
+ * coin slot and the high-score board: it tells us when to start, and we tell it the score at game over.
+ * Same-origin only. Standalone (no ?tb) the game behaves exactly like upstream.
+ */
+export const embedded = new URLSearchParams(window.location.search).has('tb');
+
+export type TbOut = { tb: 'ready' } | { tb: 'gameover'; score: number; secs: number } | { tb: 'menu' } | { tb: 'action'; a: string };
+
+export function tbPost(msg: TbOut) {
+    if (embedded && window.parent !== window) window.parent.postMessage(msg, window.location.origin);
+}
+
+/** In the arcade the page decides when a game starts (coin or practice), so the in-game start buttons only ask for the menu. */
+export function tbGate(): boolean {
+    if (!embedded) return false;
+    tbPost({ tb: 'menu' });
+    return true;
+}
+
+export function tbOnStart(cb: () => void) {
+    window.addEventListener('message', (e: MessageEvent) => {
+        if (e.origin !== window.location.origin) return;
+        if ((e.data as { tb?: string } | null)?.tb === 'start') cb();
+    });
+}
